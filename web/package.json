    "jose": "^6.2.15",
    "mariadb": "^3.5.5",
    "next": "16.4.5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
